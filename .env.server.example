# Server (docker) settings: copy to .env.server on the server; docker-compose.yml passes it in.
# Local dev keeps using .env (.env.example lists every variable).
# No empty value followed by a comment: dotenv parsers read `KEY=   # note` as "# note".

MCP_HOST=0.0.0.0                      # required in a container: 127.0.0.1 only answers from inside it
MCP_PORT=8001                         # /mcp plus the API (/health /search /ingest/*), one process
DB_PATH=/data/chroma                  # the compose volume
CONFIG_DIR=examples/bdc               # doc types and the collection name (bdc) the builder pushes into
ANONYMIZED_TELEMETRY=False            # chromadb sends usage events to PostHog by default

# the builder's bearer token; empty = ingest disabled. Generate a long random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# --- embeddings for queries: MUST be the model r-doc-builder embedded the documents with ---
EMBEDDING_MODEL_PROVIDER=ollama       # keep explicit: the URL below has no "ollama" in it, so inference would pick vllm
EMBEDDING_URL=http://host.docker.internal:11434   # Ollama on the docker host; http://ollama:11434 if it runs in compose
EMBEDDING_MODEL=bge-m3
# OPENAI_API_KEY=                     # for openai/azure providers
# AZURE_OPENAI_API_KEY=               # azure: wins over OPENAI_API_KEY; EMBEDDING_MODEL is the deployment name
# AZURE_API_VERSION=2024-10-21
