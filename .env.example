DB_PATH=./.chroma_db
# COLLECTION_NAME=config            # default: the CONFIG_DIR folder name (config, bdc, ...), one collection per example
# DB_BACKEND=chroma
# CONFIG_DIR=config                   # folder holding doc_types.yaml and prompts.yaml; examples/bdc for BDC, examples/fastapi for FastAPI
# SEARCH_K=5                          # chunks per search when the caller passes no k
# KEYWORD_FUZZY_CUTOFF=0.8            # similarity a keyword-mode fuzzy match needs (0-1)

# --- embeddings for queries: MUST be the model r-doc-builder embedded the documents with ---
# local Ollama example:  ollama pull hf.co/ggml-org/bge-m3-Q8_0-GGUF && ollama cp hf.co/ggml-org/bge-m3-Q8_0-GGUF bge-m3
EMBEDDING_MODEL_PROVIDER=ollama       # openai|azure|vllm|ollama; inferred from EMBEDDING_URL when unset
EMBEDDING_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# OPENAI_API_KEY=                     # for openai/azure providers

# --- ingest API (write path for r-doc-builder); unset = ingest disabled ---
INGEST_TOKEN=change-me

# MCP_PORT=8001                       # mcp_server.py --http port
# MCP_HOST=127.0.0.1                  # its bind address; 0.0.0.0 for other machines/containers (no auth: trusted network only)
# API_HOST=127.0.0.1                  # python -m r_doc_mcp.api dev server
# API_PORT=8000
# MCP_SERVER_NAME=r-doc-mcp           # the name the MCP server reports to clients
