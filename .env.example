DB_PATH=./.chroma_db
COLLECTION_NAME=langchain

# --- embeddings: local Ollama, bge-m3 (self-hosted, no quota) ---
# winget install Ollama.Ollama
# ollama pull hf.co/ggml-org/bge-m3-Q8_0-GGUF
# ollama cp hf.co/ggml-org/bge-m3-Q8_0-GGUF bge-m3
EMBEDDING_MODEL_PROVIDER=ollama
EMBEDDING_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# --- completion: Azure OpenAI gateway ---
COMPLETION_MODEL_PROVIDER=openai
COMPLETION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://renci-analytics.services.ai.azure.com/openai/v1
OPENAI_API_KEY=

# caps context sent to the chunk contextualizer (small-window models need this)
CONTEXT_CHAR_LIMIT=16000

# --- alternative completion: RENCI vLLM ---
# kubectl -n ner port-forward svc/vllm-server 8080:80
# COMPLETION_MODEL_PROVIDER=vllm
# COMPLETION_URL=https://vllm.apps.renci.org/v1
# COMPLETION_MODEL=google/gemma-3-12b-it
# note: the public ingress returns transient 403s under sustained load, and vLLM
# serves chat only — it rejects embedding requests, so Ollama stays in the loop

# lower if a hosted embedding endpoint rejects large batched requests
# EMBEDDING_BATCH_TOKENS=6000

# used by the MCP server to reach the API
DOC_RAG_API_URL=http://127.0.0.1:8000

# --- optional (defaults shown) ---
# EMBEDDING_MODEL_PROVIDER=ollama   # openai|azure|vllm|ollama; inferred from EMBEDDING_URL when unset
# COMPLETION_MODEL_PROVIDER=azure   # openai|azure|vllm|ollama; inferred from COMPLETION_URL when unset
# DB_PATH=./.chroma_db
# COLLECTION_NAME=langchain
# MCP_PORT=8001                     # mcp_server.py --http port
# EMBEDDING_BATCH_TOKENS=6000       # ingest.py embedding request batching
# CONTEXT_CHAR_LIMIT=16000          # preproc contextualizer doc truncation
# BDC_WEBSITE_DIR=../interim-bdc-website/
# BDC_GITBOOK_DIR=../bdc-gitbook/
# PREPROC_DATA_DIR=./data/
